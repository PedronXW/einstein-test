# Configuração do embedder (Cohere embed-v4.0 via endpoint OpenAI-compatível).
# Copie para .env e preencha OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://spillway.ensinoeinstein.com/openai/v1
OPENAI_MODEL=cohere/embed-v4.0
OPENAI_EMBEDDING_DIM=1536

# Modelo de chat do RAG (F-011) — mesmo base_url do embedder.
OPENAI_CHAT_MODEL=azure/gpt-5-mini

# Autenticação JWT (F-012) — gere um segredo forte (ex.: openssl rand -hex 32).
# Em produção, defina JWT_SECRET via ambiente/secrets manager.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Pool de conexões do Postgres (F-014) — defaults adequados para ~50 usuários.
# Total de conexões = pool_size + max_overflow. pool_timeout em segundos.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Celery (F-015) — fila de vetorização em background via Redis.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Retry da vetorização (F-020) — tentativas e backoff exponencial.
VECTORIZE_MAX_RETRIES=3
VECTORIZE_RETRY_BACKOFF=2

# Retry do LLM/RAG (F-021) — tentativas antes do 1º token.
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=1

# Modelos de LLM permitidos por usuário (F-022), separados por vírgula.
ALLOWED_MODELS=azure/gpt-5-mini,azure/gpt-6-luna

# Rate limiting (F-016) — requisições por minuto (por usuário/IP).
RATE_LIMIT_LOGIN=10
RATE_LIMIT_CHATS=30
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_FILES=10
RATE_LIMIT_USERS=20
RATE_LIMIT_GLOBAL=120